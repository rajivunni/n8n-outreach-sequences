      "position": [-760, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apollo.io/v1/mixed_people/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ api_key: $env.APOLLO_API_KEY, person_titles: ['Owner', 'Partner', 'Managing Director', 'Managing Partner', 'Founder', 'Director', 'Senior Partner', 'Practice Manager'], q_keywords: 'accounting firm chartered accountant', person_locations: ['United Kingdom'], organization_num_employees_ranges: ['1,10', '11,50', '51,200'], page: 1, per_page: $json.apollo_per_page }) }}",
        "options": {}
      },
      "id": "e1a00001-0000-0000-0000-000000000003",
      "name": "Apollo: Search Accounting Firms",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-520, 0]
    },
    {
      "parameters": {
        "jsCode": "const apolloData = $input.all()[0].json;\nconst config = $('Campaign Config').first().json;\nconst people = apolloData.people || [];\n\nif (people.length === 0) {\n  throw new Error('Apollo returned 0 contacts. Check your APOLLO_API_KEY environment variable and search criteria.');\n}\n\n// Keep only contacts with a verified email\nconst contacts = people\n  .filter(p => p.email && p.email.includes('@'))\n  .map(person => ({\n    json: {\n      firstName: (person.first_name || (person.name ? person.name.split(' ')[0] : 'there')).trim(),\n      lastName: (person.last_name || '').trim(),\n      fullName: (person.name || '').trim(),\n      companyName: ((person.organization && person.organization.name) || person.organization_name || 'your firm').trim(),\n      email: person.email.toLowerCase().trim(),\n      title: (person.title || ''),\n      linkedinUrl: (person.linkedin_url || ''),\n      location: [person.city, person.country].filter(Boolean).join(', '),\n      // Carry config through the loop\n      sender_name: config.sender_name,\n      sender_email: config.sender_email,\n      sheet_id: config.sheet_id\n    }\n  }));\n\nconsole.log(`Normalised ${contacts.length} contacts with valid emails from ${people.length} Apollo results.`);\n\nreturn contacts;"
      },
      "id": "e1a00001-0000-0000-0000-000000000004",
      "name": "Normalize Contacts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-280, 0]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "e1a00001-0000-0000-0000-000000000005",
      "name": "Email 1 Loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $input.item.json;\n\nconst subject = `Quick question about ${c.companyName}'s intake process`;\n\nconst body = `Hi ${c.firstName},\n\nI reached out a couple months back about deadline follow-ups — completely missed the mark on positioning.\n\nHere's what I should have asked:\n\nHow many prospective clients contact ${c.companyName} after 6pm or on weekends and get no response until Monday morning?\n\nMost accounting firms lose 20-30% of new client inquiries because response time runs 24-48 hours instead of under 60 seconds.\n\nBy the time someone replies, the prospect has already engaged with a competitor.\n\nWorth exploring if this is something you're seeing?\n\nBest,\n${c.sender_name}`;\n\nreturn [{\n  json: {\n    ...c,\n    email_subject: subject,\n    email_body: body\n  }\n}];"
      },
      "id": "e1a00001-0000-0000-0000-000000000006",
      "name": "Build Email 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.email_subject }}",
        "message": "={{ $json.email_body }}",
        "options": {
          "replyTo": "={{ $json.sender_email }}"
        }
      },
      "id": "e1a00001-0000-0000-0000-000000000007",
      "name": "Send Email 1",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [440, 0],
      "webhookId": "e1a00001-0000-0000-0000-000000000017"
    },
