      "id": "e2b00002-0000-0000-0000-000000000002",
      "name": "Campaign Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-760, 0]
    },
    {
      "parameters": {
        "operation": "getRows",
        "documentId": {
